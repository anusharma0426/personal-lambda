# EventBridge Schedule → Secret Rotation — example tfvars
# Copy to terraform.tfvars and fill in your values before running.

aws_region     = "ap-southeast-2"
aws_account_id = "123456789012"
name_prefix    = "demo"
environment    = "dev"
secret_name    = "secret-rotation-demo-secret"

# Every hour (default). Change to e.g. "rate(6 hours)" or "cron(0 0/6 * * ? *)"
rotation_schedule = "rate(1 hour)"

# --------------------------------------------------------------------------
# VPC (optional) — uncomment to deploy Lambda in a private VPC
# --------------------------------------------------------------------------
# vpc_id             = "vpc-0abc123456"
# subnet_ids         = ["subnet-0aaa111", "subnet-0bbb222"]
# security_group_ids = []            # leave empty to auto-create an egress-only SG
# enable_vpc_endpoints = true        # set true for fully private subnets (no NAT)
